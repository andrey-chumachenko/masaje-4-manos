{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "masaje-review-bot",
  "account_id": "3a444e68d1e824374d8a1c9f434d6e19",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-13",
  "workers_dev": true,
  "triggers": { "crons": ["* * * * *"] },
